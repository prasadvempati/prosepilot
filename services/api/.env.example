# ProsePilot API Environment Variables

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/prosepilot

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_your_clerk_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_yearly_price_id

# AI Engine (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LanguageTool (self-hosted)
LANGUAGETOOL_URL=http://localhost:8010

# App
APP_URL=http://localhost:3000
API_PORT=3001
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production
