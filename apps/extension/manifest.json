{
  "manifest_version": 3,
  "name": "ProsePilot",
  "version": "1.0.4",
  "description": "Your Writing Co-Pilot — Fix grammar, clarity, and tone instantly on any website.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://prosepilot.io/*", "http://localhost:3001/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
