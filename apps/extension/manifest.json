{
  "manifest_version": 3,
  "name": "ProsePilot",
  "version": "1.0.11",
  "description": "Your Writing Co-Pilot — Fix grammar, clarity, and tone instantly on any website.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "externally_connectable": {
    "matches": ["https://prosepilot.io/*"]
  },
  "host_permissions": ["https://api.languagetool.org/*", "https://prosepilot.io/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
