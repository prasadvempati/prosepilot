{
  "manifest_version": 3,
  "name": "ProsePilot",
  "version": "1.0.0",
  "description": "Your Writing Co-Pilot — Fix grammar, clarity, and tone instantly on any website.",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["https://prosepilot.io/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
